<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#202124">
 <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CamAPS FX" android:textColor="#B7D66B" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
  <TextView android:id="@+id/widget_glucose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--.-" android:textColor="#FFFFFF" android:textSize="38sp"/>
  <TextView android:id="@+id/widget_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="?" android:textColor="#FFFFFF" android:textSize="38sp"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_units" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="mmol/L" android:textColor="#DADCE0" android:textSize="12sp" android:gravity="center"/>
 <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for CamAPS notification" android:textColor="#BDBDBD" android:textSize="10sp" android:gravity="center" android:paddingTop="3dp"/>
</LinearLayout>
